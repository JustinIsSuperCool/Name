#Conversation Statements
print("Welcome to the tip calculator!")
total_bill = float(input("What was the total bill? $"))
tip = float(input("What tip percentage would you like to give? "))
bill_split = int(input("How many people to split the bill? "))

#math
tip = tip / 100 * total_bill
answer = (total_bill + tip) / bill_split
answer_rounded = round(answer, 2)

#Answer
print("Each person should pay: $" + str(answer_rounded))
