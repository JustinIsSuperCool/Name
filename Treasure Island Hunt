

print("Welcome to Treasure Island.")
print("Your mission is to find the treasure.")

print("You're at a crossroad. Where would you like to go?")
direction = input('Type "left" or "right" ')
if direction == "right" :
    print("You've come to a lake. There's an island in the middle of the lake.")
    travel_method = input('Type "wait" to wait for a boat. Type "swim" to swim across. ')
    if travel_method == "wait" :
        print("You arrive at the island unharmed. There is a house with 3 doors.")
        door = input("One red, one yellow, and one blue. Which color do you choose? ")
        if door == "red" :
            print("Burned by fire.")
            print("Game Over.")
        elif door == "yellow" :
            print("You Win!")
        elif door == "blue" :
            print("Eaten by beasts.")
            print("Game Over.")
        else:
            print("Game Over.")
    elif travel_method == "swim" :
        print("Attacked by a trout.")
        print("Game Over.")
    else:
        print("Game Over.")
elif direction == "left" :
    print("Fallen into a hole.")
    print("Game Over.")
else:
    print("Game Over.")
